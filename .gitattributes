# Vendored Strut helper Mach-O (arm64 Node + sherpa-onnx). See
# com.stakwork.sphinx.desktop/Supporting Files/Strut/README.md.
# All nested Mach-O the host code-signs live under native/ — do not add a
# binary anywhere else in the Strut tree without also adding an LFS rule.
"com.stakwork.sphinx.desktop/Supporting Files/Strut/native/node" filter=lfs diff=lfs merge=lfs -text
"com.stakwork.sphinx.desktop/Supporting Files/Strut/native/sherpa-onnx.node" filter=lfs diff=lfs merge=lfs -text
"com.stakwork.sphinx.desktop/Supporting Files/Strut/native/libonnxruntime.dylib" filter=lfs diff=lfs merge=lfs -text
"com.stakwork.sphinx.desktop/Supporting Files/Strut/native/libsherpa-onnx-c-api.dylib" filter=lfs diff=lfs merge=lfs -text
